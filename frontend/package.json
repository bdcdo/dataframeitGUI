{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:types": "eslint --config eslint.config.typed.mjs",
    "typecheck": "tsc --noEmit",
    "react-doctor": "react-doctor .",
    "react-doctor:diff": "react-doctor . --scope lines --base origin/main",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "scan": "react-scan http://localhost:3000",
    "test": "vitest run",
    "test:stress": "bash scripts/vitest-stress.sh",
    "test:db": "bash scripts/run-db-tests.sh",
    "test:db:psql": "bash scripts/run-sql-test.sh",
    "test:db:llm-runs-contract": "bash scripts/run-backend-integration.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "invariants": "tsx scripts/invariants/check-invariants.ts",
    "resync:compare": "tsx scripts/compare-assignments/resync.ts",
    "assign:self-comparison": "tsx --conditions=react-server scripts/self-comparison/assign.ts",
    "e2e:fixture:coding": "tsx scripts/e2e-fixtures/create-coding-save-fixture.mts",
    "e2e:fixture:compare": "tsx scripts/e2e-fixtures/create-compare-field-switch-fixture.mts",
    "e2e:fixture:llm-decisions": "tsx scripts/e2e-fixtures/create-llm-decisions-fixture.mts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.6",
    "@clerk/nextjs": "^7.9.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "sonner": "^2.0.8",
    "spark-md5": "^3.0.2",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "react-is": "$react",
    "postcss": "^8.5.16",
    "monaco-editor": {
      "dompurify": "^3.4.11"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.55",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spark-md5": "^3.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fallow": "3.41.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "react-doctor": "0.9.22",
    "react-scan": "0.5.7",
    "shadcn": "^4.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  }
}
